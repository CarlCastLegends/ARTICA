# Copia este archivo como .env (no lo subas a GitHub).

# Cadena de conexión de PostgreSQL (Neon o Supabase). Ejemplo Neon:
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Opcional en local: token de Vercel Blob para subir las fotos a la nube.
# Si lo dejas vacío, las fotos se guardan en la carpeta local ./img/{reg,afe,aco}.
# BLOB_READ_WRITE_TOKEN=
