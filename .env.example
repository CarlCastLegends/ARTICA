# Opcional: copia este archivo como .env solo si quieres cambiar algo.
# Ubicación del archivo de base de datos SQLite (por defecto ./data/artica.db)
# SQLITE_PATH=./data/artica.db
# Carpeta donde se guardan las fotos subidas (por defecto ./img)
# IMG_DIR=./img
# Puerto del servidor de producción (npm run serve:ssr:artica)
PORT=4000
